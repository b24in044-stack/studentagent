{
  "name": "learnpulse",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -b && tsc --ignoreConfig --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --esModuleInterop --skipLibCheck server.ts scripts/bootstrap-admin.ts && vite build",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "tsx server.ts --production",
    "test": "tsx --test src/lib/auth.test.ts src/lib/apiResponse.test.ts src/lib/courseState.test.ts src/lib/analytics.test.ts src/lib/academicManagement.test.ts src/lib/courseFiles.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^11.4.0",
    "firebase-admin": "^13.1.0",
    "lucide-react": "latest",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "latest",
    "react-dom": "latest",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest",
    "vite": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
