# Firebase client configuration for the browser app.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Server-side configuration for Firebase Admin SDK and Groq.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PORT=3000
# Optional Vite-to-Express target when running the frontend separately.
# Defaults to http://127.0.0.1:$PORT.
# API_PROXY_TARGET=http://127.0.0.1:3000