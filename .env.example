# Supabase client settings. Only the public anon/publishable key belongs in VITE_*.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings. Never expose SUPABASE_SECRET_KEY to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Optional server-side Groq configuration.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional server port.
PORT=3000